# Copy this file to .env and fill in your values before running.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=idms_db
DB_CONNECTION_LIMIT=10

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret_before_production
JWT_EXPIRES_IN=8h

# ── bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000

# ── Registration ──────────────────────────────────────────────────────────────
# Set to true ONLY for initial bootstrap (creating the first Director account).
# Must be false in production — registration then requires a Director JWT.
OPEN_REGISTRATION=false
